{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tennis-genome.local/schemas/market_comparison.schema.json",
  "title": "MarketComparisonV1",
  "type": "object",
  "required": [
    "comparison_id",
    "created_at",
    "prediction_id",
    "market_snapshot_id",
    "match_id",
    "model_version",
    "architecture_hash",
    "novig_method",
    "raw_implied_p_a",
    "raw_implied_p_b",
    "book_margin",
    "novig_p_a",
    "novig_p_b",
    "model_p_a",
    "model_p_b",
    "edge_a_pp",
    "edge_b_pp",
    "ev_a_per_unit",
    "ev_b_per_unit",
    "market_observed_at",
    "market_age_seconds_at_comparison",
    "decision_eligible",
    "reason_codes"
  ],
  "properties": {
    "comparison_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "prediction_id": {"type": "string", "minLength": 1},
    "market_snapshot_id": {"type": "string", "minLength": 1},
    "match_id": {"type": "string", "minLength": 1},
    "model_version": {"const": "TGE-Independent-v1"},
    "architecture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "novig_method": {"const": "proportional_two_way_v1"},
    "raw_implied_p_a": {"type": "number", "minimum": 0, "maximum": 1},
    "raw_implied_p_b": {"type": "number", "minimum": 0, "maximum": 1},
    "book_margin": {"type": "number"},
    "novig_p_a": {"type": "number", "minimum": 0, "maximum": 1},
    "novig_p_b": {"type": "number", "minimum": 0, "maximum": 1},
    "model_p_a": {"type": "number", "minimum": 0, "maximum": 1},
    "model_p_b": {"type": "number", "minimum": 0, "maximum": 1},
    "edge_a_pp": {"type": "number"},
    "edge_b_pp": {"type": "number"},
    "ev_a_per_unit": {"type": "number"},
    "ev_b_per_unit": {"type": "number"},
    "market_observed_at": {"type": "string", "format": "date-time"},
    "market_age_seconds_at_comparison": {"type": "number", "minimum": 0},
    "decision_eligible": {"type": "boolean"},
    "reason_codes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
