{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tennis-genome.local/schemas/prediction.schema.json",
  "title": "Prediction",
  "type": "object",
  "required": ["prediction_id", "match_id", "created_at", "prediction_cutoff_at", "model_version", "p_player_a", "action"],
  "properties": {
    "prediction_id": {"type": "string"},
    "match_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "prediction_cutoff_at": {"type": "string", "format": "date-time"},
    "model_version": {"type": "string"},
    "feature_version": {"type": ["string", "null"]},
    "calibration_version": {"type": ["string", "null"]},
    "policy_version": {"type": ["string", "null"]},
    "fingerprint_hash": {"type": ["string", "null"]},
    "p_player_a": {"type": "number", "minimum": 0, "maximum": 1},
    "p_player_b": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "uncertainty_low": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "uncertainty_high": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "model_disagreement": {"type": ["number", "null"], "minimum": 0},
    "historical_density": {"type": ["number", "null"]},
    "data_quality_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "market_snapshot_id": {"type": ["string", "null"]},
    "market_novig_p_player_a": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "edge_pp": {"type": ["number", "null"]},
    "expected_value_per_unit": {"type": ["number", "null"]},
    "action": {"type": "string", "enum": ["BET_A", "BET_B", "PASS", "PREDICT_ONLY"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "stake_units": {"type": ["number", "null"], "minimum": 0},
    "outcome_attached_at": {"type": ["string", "null"], "format": "date-time"},
    "outcome_player_a_won": {"type": ["boolean", "null"]},
    "realized_profit_units": {"type": ["number", "null"]},
    "closing_line_value": {"type": ["number", "null"]}
  },
  "additionalProperties": false
}
