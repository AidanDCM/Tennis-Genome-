{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tennis-genome.local/schemas/player_snapshot.schema.json",
  "title": "PlayerProfileSnapshotV1",
  "description": "Match-scoped, date-precision pre-match player state. Predictive permission is defined separately in profiles/spec.py; presence here never implies predictive promotion.",
  "type": "object",
  "required": [
    "profile_hash",
    "player_id",
    "player_name",
    "tour",
    "valid_from",
    "valid_until",
    "data_cutoff",
    "profile_version",
    "elo_rating",
    "prior_matches",
    "serve_rating",
    "return_rating",
    "prior_serve_points",
    "prior_return_points",
    "form_result_30",
    "form_result_90",
    "form_point_30",
    "form_point_90",
    "event_gap_days",
    "minutes_7",
    "minutes_14",
    "minutes_28",
    "matches_14",
    "matches_28",
    "previous_event_minutes",
    "has_point_history",
    "has_complete_14d_duration"
  ],
  "properties": {
    "profile_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Deterministic SHA-256 content identifier for the snapshot."
    },
    "player_id": {"type": "string", "minLength": 1},
    "player_name": {"type": "string"},
    "tour": {"enum": ["ATP", "WTA"]},
    "valid_from": {
      "type": "string",
      "format": "date",
      "description": "Source-date at which this match-scoped snapshot is observed."
    },
    "valid_until": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Null for live/as-of prediction snapshots. Closing historical intervals must be a downstream storage operation and may not alter prediction features."
    },
    "data_cutoff": {
      "type": "string",
      "format": "date",
      "description": "Latest source date permitted to contribute to dynamic state. Current-date outcomes/stats are excluded by frozen-date semantics."
    },
    "profile_version": {"const": "player-profile-v1"},

    "ranking": {"type": ["integer", "null"], "minimum": 1},
    "ranking_points": {"type": ["integer", "null"], "minimum": 0},
    "age_years": {"type": ["number", "null"], "minimum": 0},
    "height_cm": {"type": ["integer", "null"], "minimum": 0},
    "hand": {"type": ["string", "null"]},
    "ioc": {"type": ["string", "null"]},

    "elo_rating": {"type": "number"},
    "prior_matches": {"type": "integer", "minimum": 0},

    "serve_rating": {"type": "number"},
    "return_rating": {"type": "number"},
    "prior_serve_points": {"type": "integer", "minimum": 0},
    "prior_return_points": {"type": "integer", "minimum": 0},

    "form_result_30": {"type": "number"},
    "form_result_90": {"type": "number"},
    "form_point_30": {"type": "number"},
    "form_point_90": {"type": "number"},

    "event_gap_days": {"type": ["number", "null"], "minimum": 0},
    "minutes_7": {"type": ["number", "null"], "minimum": 0},
    "minutes_14": {"type": ["number", "null"], "minimum": 0},
    "minutes_28": {"type": ["number", "null"], "minimum": 0},
    "matches_14": {"type": "integer", "minimum": 0},
    "matches_28": {"type": "integer", "minimum": 0},
    "previous_event_minutes": {"type": ["integer", "null"], "minimum": 0},

    "has_point_history": {"type": "boolean"},
    "has_complete_14d_duration": {"type": "boolean"}
  },
  "additionalProperties": false
}
