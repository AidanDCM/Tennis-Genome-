{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tennis-genome.local/schemas/player_snapshot.schema.json",
  "title": "PlayerSnapshot",
  "type": "object",
  "required": ["snapshot_id", "player_id", "valid_from", "data_cutoff", "profile_version"],
  "properties": {
    "snapshot_id": {"type": "string"},
    "player_id": {"type": "string"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "computed_at": {"type": ["string", "null"], "format": "date-time"},
    "data_cutoff": {"type": "string", "format": "date-time"},
    "profile_version": {"type": "string"},
    "age_years": {"type": ["number", "null"]},
    "overall_elo": {"type": ["number", "null"]},
    "hard_elo": {"type": ["number", "null"]},
    "clay_elo": {"type": ["number", "null"]},
    "grass_elo": {"type": ["number", "null"]},
    "serve_rating": {"type": ["number", "null"]},
    "return_rating": {"type": ["number", "null"]},
    "recent_form_rating": {"type": ["number", "null"]},
    "profile_strength": {"type": ["number", "null"]},
    "workload_24h": {"type": ["number", "null"]},
    "workload_72h": {"type": ["number", "null"]},
    "workload_7d": {"type": ["number", "null"]},
    "rest_hours": {"type": ["number", "null"]},
    "injury_state": {"type": ["string", "null"]},
    "coverage_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "reliability_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "effective_sample_size": {"type": ["number", "null"], "minimum": 0},
    "feature_payload": {"type": "object"},
    "source_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
