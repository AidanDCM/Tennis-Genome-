{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tennis-genome.local/schemas/market_snapshot.schema.json",
  "title": "MarketSnapshotV1",
  "type": "object",
  "required": [
    "market_snapshot_id",
    "match_id",
    "provider",
    "bookmaker",
    "market_type",
    "collected_at",
    "observed_at",
    "player_a_id",
    "player_b_id",
    "selection_a_name",
    "selection_b_name",
    "decimal_odds_a",
    "decimal_odds_b",
    "source_event_id",
    "source_payload_sha256",
    "is_live",
    "is_suspended"
  ],
  "properties": {
    "market_snapshot_id": {"type": "string", "minLength": 1},
    "match_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "bookmaker": {"type": "string", "minLength": 1},
    "market_type": {"const": "h2h"},
    "collected_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "commence_at": {"type": ["string", "null"], "format": "date-time"},
    "player_a_id": {"type": "string", "minLength": 1},
    "player_b_id": {"type": "string", "minLength": 1},
    "selection_a_name": {"type": "string", "minLength": 1},
    "selection_b_name": {"type": "string", "minLength": 1},
    "decimal_odds_a": {"type": "number", "exclusiveMinimum": 1},
    "decimal_odds_b": {"type": "number", "exclusiveMinimum": 1},
    "source_event_id": {"type": "string", "minLength": 1},
    "source_market_id": {"type": ["string", "null"]},
    "source_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "is_live": {"type": "boolean"},
    "is_suspended": {"type": "boolean"},
    "identity_resolution_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
